<?xml version="1.0" encoding="utf-8"?>

<!--
    Das Dashboard bleibt scrollbar, wenn viele Dokumente vorhanden sind.
    fitsSystemWindows verhindert eine Überlagerung durch die Statusleiste.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/docu_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <!-- Hauptcontainer des Dashboards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <!--
            Vollständiges freigegebenes Logo.
            adjustViewBounds und fitCenter verhindern Abschneiden und Verzerren.
        -->
        <ImageView
            android:id="@+id/imageDashboardLogo"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:contentDescription="DocuRemind Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/docuremind_logo_full" />

        <!-- Hauptüberschrift des Dashboards -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Deine Fristen im Blick"
            android:textColor="@color/docu_text_primary"
            android:textSize="29sp"
            android:textStyle="bold" />

        <!-- Kurze Erklärung des Dashboards -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Verwalte Dokumente und erkenne rechtzeitig, was als Nächstes fällig wird."
            android:textColor="@color/docu_text_secondary"
            android:textSize="15sp" />

        <!-- Primäre Aktion zum Erstellen eines Dokuments -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddDocument"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/docu_primary"
            android:text="Neues Dokument hinzufügen"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="15dp" />

        <!-- Zeile mit Einstellungen und Logout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSettings"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:backgroundTint="@color/docu_surface"
                android:text="Einstellungen"
                android:textAllCaps="false"
                android:textColor="@color/docu_primary"
                app:cornerRadius="14dp"
                app:strokeColor="@color/docu_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLogout"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:backgroundTint="@color/docu_surface"
                android:text="Ausloggen"
                android:textAllCaps="false"
                android:textColor="@color/docu_text_secondary"
                app:cornerRadius="14dp"
                app:strokeColor="@color/docu_border"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- Überschrift und Anzahl der Dokumente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Meine Dokumente"
                android:textColor="@color/docu_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDocumentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Dokumente"
                android:textColor="@color/docu_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Ladeanzeige während der Firestore-Abfrage -->
        <ProgressBar
            android:id="@+id/progressDocuments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:indeterminateTint="@color/docu_primary"
            android:visibility="gone" />

        <!-- Hinweis bei einer leeren Dokumentliste -->
        <TextView
            android:id="@+id/textEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/docu_surface"
            android:gravity="center"
            android:padding="28dp"
            android:text="Noch keine Dokumente gespeichert."
            android:textColor="@color/docu_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Dynamisch von DashboardActivity befüllte Dokumentliste -->
        <LinearLayout
            android:id="@+id/layoutDocumentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
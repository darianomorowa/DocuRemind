<?xml version="1.0" encoding="utf-8"?>

<!--
    Der Login-Screen ist scrollbar, damit er auch bei geöffneter
    Tastatur und auf kleineren Displays vollständig erreichbar bleibt.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/docu_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <!-- Hauptcontainer des Login-Screens -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="38dp"
        android:paddingRight="24dp"
        android:paddingBottom="32dp">

        <!--
            Vollständiges freigegebenes Logo:
            Signet, Wortmarke und Slogan bleiben im Originalverhältnis.
        -->
        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="DocuRemind Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/docuremind_logo_full" />

        <!-- Karte mit Login und Registrierung -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/docu_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/docu_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Überschrift des Login-Bereichs -->
                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Willkommen"
                    android:textColor="@color/docu_text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="22dp"
                    android:text="Melde dich an oder erstelle ein neues Konto."
                    android:textColor="@color/docu_text_secondary"
                    android:textSize="15sp" />

                <!-- Eingabe der E-Mail-Adresse -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="E-Mail"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/docu_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Eingabe des Passworts -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Passwort"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/docu_primary"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Anmeldung eines bestehenden Nutzers -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/docu_primary"
                    android:text="Einloggen"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:cornerRadius="15dp" />

                <!-- Registrierung eines neuen Nutzers -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRegister"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/docu_surface"
                    android:text="Neues Konto registrieren"
                    android:textAllCaps="false"
                    android:textColor="@color/docu_primary"
                    android:textSize="16sp"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/docu_primary"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>